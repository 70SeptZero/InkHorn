  BLOCK "080404b0"
  BEGIN
   VALUE "FileDescription", "InkHorn\0"
   VALUE "ProductName", "InkHorn\0"
   VALUE "InternalName", "InkHorn\0"
   VALUE "OriginalFilename", "InkHorn.exe\0"
   VALUE "FileVersion", "0.1.0.0\0"
   VALUE "ProductVersion", "0.1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0804, 1200
 END
END
